@model List<Supplier>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fas fa-truck text-success me-2"></i>Suppliers</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus me-1"></i>Add Supplier</a>
</div>
<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-success"><tr><th>Name</th><th>Contact</th><th>Phone</th><th>Email</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td class="fw-bold">@s.Name</td><td>@s.ContactPerson</td><td>@s.Phone</td><td>@s.Email</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info me-1"><i class="fas fa-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></a>
                        <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>