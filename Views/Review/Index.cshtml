@model List<ReviewViewModel>

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-star me-2 text-warning"></i>All Reviews</h2>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-success">
                        <tr><th>User</th><th>Pharmacy</th><th>Rating</th><th>Comment</th><th>Date</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var review in Model)
                        {
                            <tr>
                                <td>@review.UserName</td>
                                <td><a asp-controller="Pharmacy" asp-action="Details" asp-route-id="@review.PharmacyId">@review.PharmacyName</a></td>
                                <td>
                                    <span class="text-warning">
                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                    </span>
                                </td>
                                <td>@(review.Comment ?? "-")</td>
                                <td>@review.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <form asp-action="Delete" asp-route-id="@review.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this review?')"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>