<section class="bg-success text-white py-5 rounded-3 mb-4">
    <div class="text-center">
        <h1 class="display-4 fw-bold"><i class="fas fa-pills me-2"></i>PharmaLink</h1>
        <p class="lead">Pharmacy Management and Medicine Availability Platform</p>
        <a asp-controller="Medicine" asp-action="Index" class="btn btn-light btn-lg me-2"><i class="fas fa-search me-1"></i>Browse Medicines</a>
        <a asp-controller="Pharmacy" asp-action="Index" class="btn btn-outline-light btn-lg"><i class="fas fa-store me-1"></i>Find Pharmacies</a>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white"><div class="card-body text-center"><i class="fas fa-capsules fa-2x mb-2"></i><h3>@ViewBag.TotalMedicines</h3><small>Medicines</small></div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success text-white"><div class="card-body text-center"><i class="fas fa-store fa-2x mb-2"></i><h3>@ViewBag.TotalPharmacies</h3><small>Pharmacies</small></div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info text-white"><div class="card-body text-center"><i class="fas fa-truck fa-2x mb-2"></i><h3>@ViewBag.TotalSuppliers</h3><small>Suppliers</small></div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning text-dark"><div class="card-body text-center"><i class="fas fa-cash-register fa-2x mb-2"></i><h3>@ViewBag.TotalSales</h3><small>Sales</small></div></div>
    </div>
</div>