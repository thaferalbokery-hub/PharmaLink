@{
    var openPharmacies = ViewBag.OpenPharmacies as List<PharmacyListViewModel> ?? new List<PharmacyListViewModel>();
    var categories = ViewBag.Categories as List<MedicineCategory> ?? new List<MedicineCategory>();
    var recentMedicines = ViewBag.RecentMedicines as List<MedicineListViewModel> ?? new List<MedicineListViewModel>();
}

<!-- Hero Section -->
<section class="bg-success text-white py-5">
    <div class="container text-center">
        <h1 class="display-4 fw-bold mb-3">
            <i class="fas fa-pills me-2"></i>PharmaLink
        </h1>
        <p class="lead mb-4">Find medicines, check availability, and compare prices from pharmacies near you</p>
        <div class="row justify-content-center">
            <div class="col-md-8">
                <form asp-controller="Medicine" asp-action="Search" method="get" class="input-group input-group-lg">
                    <input type="text" name="q" class="form-control" placeholder="Search by medicine name (scientific or commercial)..." />
                    <button class="btn btn-warning" type="submit">
                        <i class="fas fa-search"></i> Search
                    </button>
                </form>
            </div>
        </div>
        <div class="mt-3">
            <span class="badge bg-light text-dark me-2"><i class="fas fa-store me-1"></i>@ViewData["TotalPharmacies"] Pharmacies</span>
            <span class="badge bg-light text-dark"><i class="fas fa-pills me-1"></i>@ViewData["TotalMedicines"] Medicines</span>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h3 class="fw-bold mb-4"><i class="fas fa-th-large me-2 text-success"></i>Medicine Categories</h3>
        <div class="row g-3">
            @foreach (var category in categories.Take(8))
            {
                <div class="col-6 col-md-3">
                    <a asp-controller="Medicine" asp-action="Search" asp-route-categoryId="@category.Id" class="text-decoration-none">
                        <div class="card text-center border-0 shadow-sm h-100 hover-card">
                            <div class="card-body">
                                <i class="fas fa-capsules fa-2x text-success mb-2"></i>
                                <h6 class="card-title text-dark">@category.Name</h6>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Open Pharmacies -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold"><i class="fas fa-store me-2 text-success"></i>Open Pharmacies</h3>
            <a asp-controller="Pharmacy" asp-action="Search" class="btn btn-outline-success">View All</a>
        </div>
        <div class="row g-4">
            @foreach (var pharmacy in openPharmacies)
            {
                <div class="col-md-4">
                    @await Html.PartialAsync("_PharmacyCard", pharmacy)
                </div>
            }
        </div>
    </div>
</section>

<!-- Recent Medicines -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold"><i class="fas fa-pills me-2 text-success"></i>Recently Updated Medicines</h3>
            <a asp-controller="Medicine" asp-action="Index" class="btn btn-outline-success">View All</a>
        </div>
        <div class="row g-4">
            @foreach (var medicine in recentMedicines.Take(4))
            {
                <div class="col-md-3">
                    @await Html.PartialAsync("_MedicineCard", medicine)
                </div>
            }
        </div>
    </div>
</section>