@model List<SearchHistory>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-history me-2 text-success"></i>Search History</h2>
        @if (Model.Any())
        {
            <form asp-action="Clear" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Clear all search history?')">
                    <i class="fas fa-trash me-1"></i>Clear All
                </button>
            </form>
        }
    </div>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr><th>Search Term</th><th>Type</th><th>Date</th><th>Action</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model)
                            {
                                <tr>
                                    <td>
                                        @if (entry.SearchType == "Medicine")
                                        {
                                            <a asp-controller="Medicine" asp-action="Search" asp-route-q="@entry.SearchTerm" class="text-decoration-none">
                                                @entry.SearchTerm
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Pharmacy" asp-action="Search" asp-route-q="@entry.SearchTerm" class="text-decoration-none">
                                                @entry.SearchTerm
                                            </a>
                                        }
                                    </td>
                                    <td><span class="badge bg-info">@entry.SearchType</span></td>
                                    <td>@entry.SearchDate.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        <form asp-action="Delete" asp-route-id="@entry.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-times"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-search fa-3x text-muted mb-3"></i>
            <p class="text-muted">No search history yet.</p>
        </div>
    }
</div>