@model PharmacySearchViewModel

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-search me-2 text-success"></i>Find Pharmacies</h2>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Search" method="get" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="q" value="@Model.SearchTerm" class="form-control" placeholder="Search by name or address..." />
                </div>
                <div class="col-md-3">
                    <select name="city" class="form-select">
                        <option value="">All Cities</option>
                        @foreach (var city in Model.Cities)
                        {
                            <option value="@city" selected="@(Model.City == city)">@city</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="isOpen" class="form-select">
                        <option value="">All Status</option>
                        <option value="true" selected="@(Model.IsOpen == true)">Open Now</option>
                        <option value="false" selected="@(Model.IsOpen == false)">Closed</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-success w-100"><i class="fas fa-search me-1"></i>Search</button>
                </div>
            </form>
        </div>
    </div>

    @if (ViewData["SearchResultCount"] != null)
    {
        <p class="text-muted mb-3">Found <strong>@ViewData["SearchResultCount"]</strong> pharmacies</p>
    }

    <div class="row g-4">
        @foreach (var pharmacy in Model.Results)
        {
            <div class="col-md-4">
                @await Html.PartialAsync("_PharmacyCard", pharmacy)
            </div>
        }
    </div>

    @if (!Model.Results.Any() && !string.IsNullOrEmpty(Model.SearchTerm))
    {
        <div class="text-center py-5">
            <i class="fas fa-store fa-3x text-muted mb-3"></i>
            <p class="text-muted">No pharmacies found matching your criteria.</p>
        </div>
    }
</div>