@model List<PharmacyListViewModel>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-store me-2 text-success"></i>All Pharmacies</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus me-2"></i>Add Pharmacy</a>
        }
    </div>

    <div class="row g-4">
        @foreach (var pharmacy in Model)
        {
            <div class="col-md-4">
                @await Html.PartialAsync("_PharmacyCard", pharmacy)
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-store fa-3x text-muted mb-3"></i>
            <p class="text-muted">No pharmacies found.</p>
        </div>
    }
</div>