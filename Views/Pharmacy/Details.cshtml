@model Pharmacy
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Pharmacies</a></li><li class="breadcrumb-item active">@Model.Name</li></ol></nav>
<div class="row">
    <div class="col-md-4">
        @if (Model.ImageUrl != null) { <img src="@Model.ImageUrl" class="img-fluid rounded shadow" /> }
        else { <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:200px;"><i class="fas fa-store fa-4x text-success"></i></div> }
    </div>
    <div class="col-md-8">
        <h2 class="fw-bold">@Model.Name</h2>
        @if (Model.IsOpen) { <span class="badge bg-success fs-6">Open</span> } else { <span class="badge bg-danger fs-6">Closed</span> }
        <p class="mt-3">@Model.Description</p>
        <table class="table table-sm">
            <tr><th>Address</th><td>@Model.Address, @Model.City</td></tr>
            @if (Model.Phone != null) { <tr><th>Phone</th><td>@Model.Phone</td></tr> }
            @if (Model.Email != null) { <tr><th>Email</th><td>@Model.Email</td></tr> }
        </table>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary me-2"><i class="fas fa-edit"></i> Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="fas fa-trash"></i> Delete</a>
        }
    </div>
</div>