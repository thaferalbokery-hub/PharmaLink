<h2 class="fw-bold mb-4"><i class="fas fa-chart-bar text-success me-2"></i>Reports</h2>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4>@ViewBag.TotalMedicines</h4><small>Medicines</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4>@ViewBag.TotalPharmacies</h4><small>Pharmacies</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4>@ViewBag.TotalSuppliers</h4><small>Suppliers</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4>@ViewBag.TotalSales</h4><small>Sales</small></div></div></div>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><h5>Revenue</h5><h3 class="text-success">@(((decimal)ViewBag.TotalRevenue).ToString("C"))</h3><small>Average: @(((decimal)ViewBag.AverageSale).ToString("C"))</small></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><h5>Inventory</h5><h3 class="text-danger">@ViewBag.LowStockItems</h3><small>Low Stock Items</small></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><h5>Prescriptions</h5><h3>@ViewBag.TotalPrescriptions</h3><small>Pending: @ViewBag.PendingPrescriptions</small></div></div></div>
</div>