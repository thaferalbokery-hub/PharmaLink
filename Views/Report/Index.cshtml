@using PharmaLink.ViewModels
<h2 class="fw-bold mb-4"><i class="fas fa-chart-bar text-success me-2"></i>Reports &amp; Analytics</h2>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm bg-primary text-white"><div class="card-body text-center"><i class="fas fa-capsules fa-2x mb-2"></i><h3>@ViewBag.TotalMedicines</h3><small>Medicines</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm bg-success text-white"><div class="card-body text-center"><i class="fas fa-store fa-2x mb-2"></i><h3>@ViewBag.TotalPharmacies</h3><small>Pharmacies</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm bg-info text-white"><div class="card-body text-center"><i class="fas fa-truck fa-2x mb-2"></i><h3>@ViewBag.TotalSuppliers</h3><small>Suppliers</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm bg-warning text-dark"><div class="card-body text-center"><i class="fas fa-users fa-2x mb-2"></i><h3>@ViewBag.TotalUsers</h3><small>Users</small></div></div></div>
</div>

<!-- Revenue & Sales -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <h5 class="card-title"><i class="fas fa-dollar-sign text-success me-2"></i>Revenue</h5>
            <h3 class="text-success fw-bold">@(((decimal)ViewBag.TotalRevenue).ToString("C"))</h3>
            <small class="text-muted">Average per sale: @(((decimal)ViewBag.AverageSale).ToString("C"))</small><br/>
            <small class="text-muted">Total sales: @ViewBag.TotalSales</small>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <h5 class="card-title"><i class="fas fa-boxes-stacked text-warning me-2"></i>Inventory Alerts</h5>
            <h3 class="text-warning fw-bold">@ViewBag.LowStockItems</h3>
            <small class="text-muted">Low stock items</small><br/>
            <span class="badge bg-danger">@ViewBag.OutOfStockItems out of stock</span>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <h5 class="card-title"><i class="fas fa-prescription text-info me-2"></i>Prescriptions</h5>
            <h3 class="text-info fw-bold">@ViewBag.TotalPrescriptions</h3>
            <small class="text-muted">Pending: <span class="badge bg-warning text-dark">@ViewBag.PendingPrescriptions</span></small><br/>
            <small class="text-muted">Approved: <span class="badge bg-success">@ViewBag.ApprovedPrescriptions</span></small>
        </div></div>
    </div>
</div>

<!-- Top Selling Medicines (Column Projection Result) -->
@if (ViewBag.TopSellingMedicines != null)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white"><h5 class="mb-0"><i class="fas fa-trophy text-warning me-2"></i>Top Selling Medicines <small class="text-muted">(Column Projection with .Select())</small></h5></div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>#</th><th>Medicine</th><th>Qty Sold</th><th>Revenue</th></tr></thead>
                    <tbody>
                        @{ var rank = 1; }
                        @foreach (var item in (List<MedicineReportDto>)ViewBag.TopSellingMedicines)
                        {
                            <tr><td>@(rank++)</td><td class="fw-bold">@item.MedicineName</td><td>@item.TotalQuantitySold</td><td class="text-success fw-bold">@item.TotalRevenue.ToString("C")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Sales by Pharmacy -->
@if (ViewBag.SalesByPharmacy != null)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white"><h5 class="mb-0"><i class="fas fa-store text-success me-2"></i>Sales by Pharmacy</h5></div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>Pharmacy</th><th>Total Sales</th><th>Revenue</th></tr></thead>
                    <tbody>
                        @foreach (var item in (List<PharmacySalesDto>)ViewBag.SalesByPharmacy)
                        {
                            <tr><td class="fw-bold">@item.PharmacyName</td><td>@item.TotalSales</td><td class="text-success fw-bold">@item.TotalRevenue.ToString("C")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Low Stock Alert -->
@if (ViewBag.LowStockMedicines != null)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white"><h5 class="mb-0"><i class="fas fa-exclamation-triangle text-danger me-2"></i>Low Stock Alert</h5></div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>Pharmacy</th><th>Medicine</th><th>Current Stock</th><th>Min Level</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var item in (List<LowStockDto>)ViewBag.LowStockMedicines)
                        {
                            <tr>
                                <td>@item.PharmacyName</td><td>@item.MedicineName</td>
                                <td class="fw-bold">@item.CurrentStock</td><td>@item.MinimumLevel</td>
                                <td>@if(item.CurrentStock == 0){<span class="badge bg-danger">Out of Stock</span>}else{<span class="badge bg-warning text-dark">Low Stock</span>}</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}