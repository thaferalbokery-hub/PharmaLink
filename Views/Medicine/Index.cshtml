@model List<Medicine>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fas fa-capsules text-success me-2"></i>Medicines</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
    {
        <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus me-1"></i>Add Medicine</a>
    }
</div>
<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-5"><input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Search medicines..." /></div>
    <div class="col-md-4">
        <select name="category" class="form-select">
            <option value="">All Categories</option>
            @foreach (var cat in (List<string>)ViewBag.Categories)
            {
                <option value="@cat" selected="@(ViewData["CurrentCategory"]?.ToString() == cat)">@cat</option>
            }
        </select>
    </div>
    <div class="col-md-3"><button type="submit" class="btn btn-outline-success w-100"><i class="fas fa-search me-1"></i>Filter</button></div>
</form>
<div class="row g-3">
    @foreach (var med in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                @if (med.ImageUrl != null)
                { <img src="@med.ImageUrl" class="card-img-top" style="height:160px;object-fit:cover;" alt="@med.Name" /> }
                else
                { <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:160px;"><i class="fas fa-pills fa-3x text-success"></i></div> }
                <div class="card-body">
                    <h6 class="fw-bold">@med.Name</h6>
                    <span class="badge bg-info">@med.Category</span>
                    @if (med.RequiresPrescription) { <span class="badge bg-warning text-dark">Rx</span> }
                    <p class="mt-2 mb-0 fw-bold text-success">@med.Price.ToString("C")</p>
                </div>
                <div class="card-footer bg-white border-0">
                    <a asp-action="Details" asp-route-id="@med.Id" class="btn btn-outline-success btn-sm w-100">View Details</a>
                </div>
            </div>
        </div>
    }
</div>
@if (!Model.Any()) { <p class="text-center text-muted py-5">No medicines found.</p> }