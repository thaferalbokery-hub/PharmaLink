@model List<MedicineListViewModel>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-pills me-2 text-success"></i>All Medicines</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus me-2"></i>Add Medicine</a>
        }
    </div>

    <div class="row g-4">
        @foreach (var medicine in Model)
        {
            <div class="col-md-3">
                @await Html.PartialAsync("_MedicineCard", medicine)
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-pills fa-3x text-muted mb-3"></i>
            <p class="text-muted">No medicines found.</p>
        </div>
    }
</div>