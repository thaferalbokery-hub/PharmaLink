@model MedicineCreateViewModel

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-plus-circle me-2 text-success"></i>Add Medicine</h2>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ScientificName" class="form-label">Scientific Name</label>
                        <input asp-for="ScientificName" class="form-control" />
                        <span asp-validation-for="ScientificName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CommercialName" class="form-label">Commercial Name</label>
                        <input asp-for="CommercialName" class="form-control" />
                        <span asp-validation-for="CommercialName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId" class="form-label">Category</label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">-- Select Category --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="BrandId" class="form-label">Brand</label>
                        <select asp-for="BrandId" class="form-select">
                            <option value="">-- Select Brand --</option>
                            @foreach (var brand in Model.Brands)
                            {
                                <option value="@brand.Id">@brand.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="DosageForm" class="form-label">Dosage Form</label>
                        <input asp-for="DosageForm" class="form-control" placeholder="e.g., Tablet, Capsule" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Strength" class="form-label">Strength</label>
                        <input asp-for="Strength" class="form-control" placeholder="e.g., 500mg" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Unit" class="form-label">Unit</label>
                        <input asp-for="Unit" class="form-control" placeholder="e.g., mg, ml" />
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RequiresPrescription" class="form-check-input" />
                    <label asp-for="RequiresPrescription" class="form-check-label">Requires Prescription</label>
                </div>

                <div class="mb-3">
                    <label asp-for="Image" class="form-label">Medicine Image</label>
                    <input asp-for="Image" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success"><i class="fas fa-save me-2"></i>Create Medicine</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}