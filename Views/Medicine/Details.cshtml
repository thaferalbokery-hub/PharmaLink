@model Medicine
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Medicines</a></li><li class="breadcrumb-item active">@Model.Name</li></ol></nav>
<div class="row">
    <div class="col-md-4">
        @if (Model.ImageUrl != null) { <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Name" /> }
        else { <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:250px;"><i class="fas fa-pills fa-5x text-success"></i></div> }
    </div>
    <div class="col-md-8">
        <h2 class="fw-bold">@Model.Name</h2>
        <span class="badge bg-info">@Model.Category</span>
        @if (Model.RequiresPrescription) { <span class="badge bg-warning text-dark">Requires Prescription</span> }
        <p class="mt-3">@Model.Description</p>
        <table class="table table-sm mt-3">
            <tr><th>Price</th><td class="fw-bold text-success">@Model.Price.ToString("C")</td></tr>
            <tr><th>Stock</th><td>@Model.Quantity</td></tr>
            @if (Model.ExpiryDate.HasValue) { <tr><th>Expiry</th><td>@Model.ExpiryDate.Value.ToString("MMM dd, yyyy")</td></tr> }
        </table>
        @if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary me-2"><i class="fas fa-edit"></i> Edit</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="fas fa-trash"></i> Delete</a>
            }
        }
    </div>
</div>

@if (Model.Inventories.Any())
{
    <h4 class="mt-4 fw-bold">Available at Pharmacies</h4>
    <table class="table table-hover">
        <thead class="table-light"><tr><th>Pharmacy</th><th>Stock</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var inv in Model.Inventories)
            {
                <tr><td>@inv.Pharmacy.Name</td><td>@inv.Quantity</td><td>@(inv.IsLowStock ? "<span class='badge bg-warning'>Low</span>" : "<span class='badge bg-success'>OK</span>")</td></tr>
            }
        </tbody>
    </table>
}

@if (Model.SupplierMedicines.Any())
{
    <h4 class="mt-4 fw-bold">Suppliers</h4>
    <table class="table table-hover">
        <thead class="table-light"><tr><th>Supplier</th><th>Supply Price</th><th>Available</th></tr></thead>
        <tbody>
            @foreach (var sm in Model.SupplierMedicines)
            {
                <tr><td>@sm.Supplier.Name</td><td>@sm.SupplyPrice.ToString("C")</td><td>@sm.AvailableQuantity</td></tr>
            }
        </tbody>
    </table>
}