@model MedicineDetailsViewModel

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Medicine" asp-action="Index">Medicines</a></li>
            <li class="breadcrumb-item active">@Model.CommercialName</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-4">
            @if (Model.Images.Any())
            {
                <img src="@Model.Images.First().ImageUrl" class="img-fluid rounded shadow" alt="@Model.CommercialName" />
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center shadow" style="height: 300px;">
                    <i class="fas fa-pills fa-5x text-success"></i>
                </div>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-action="ToggleFavorite" asp-route-id="@Model.Id" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn @(Model.IsFavorited ? "btn-danger" : "btn-outline-danger") w-100">
                        <i class="fas fa-heart me-2"></i>@(Model.IsFavorited ? "Remove from Favorites" : "Add to Favorites")
                    </button>
                </form>
            }
        </div>
        <div class="col-md-8">
            <h2 class="fw-bold">@Model.CommercialName</h2>
            <h5 class="text-muted">@Model.ScientificName</h5>

            <div class="mt-3">
                <span class="badge bg-info me-2">@Model.CategoryName</span>
                @if (Model.BrandName != null)
                {
                    <span class="badge bg-secondary me-2">@Model.BrandName</span>
                }
                @if (Model.RequiresPrescription)
                {
                    <span class="badge bg-warning text-dark"><i class="fas fa-prescription me-1"></i>Requires Prescription</span>
                }
            </div>

            @if (Model.Description != null)
            {
                <div class="mt-3">
                    <h6 class="fw-bold">Description</h6>
                    <p>@Model.Description</p>
                </div>
            }

            <div class="row mt-3">
                @if (Model.DosageForm != null)
                {
                    <div class="col-md-4"><strong>Dosage Form:</strong><br />@Model.DosageForm</div>
                }
                @if (Model.Strength != null)
                {
                    <div class="col-md-4"><strong>Strength:</strong><br />@Model.Strength</div>
                }
                @if (Model.Unit != null)
                {
                    <div class="col-md-4"><strong>Unit:</strong><br />@Model.Unit</div>
                }
            </div>
        </div>
    </div>

    <!-- Pharmacy Availability -->
    <div class="mt-5">
        <h4 class="fw-bold"><i class="fas fa-store me-2 text-success"></i>Available at Pharmacies</h4>
        @if (Model.PharmacyAvailabilities.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mt-3">
                    <thead class="table-success">
                        <tr><th>Pharmacy</th><th>City</th><th>Status</th><th>Price</th><th>Availability</th><th>Last Updated</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var pa in Model.PharmacyAvailabilities)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Pharmacy" asp-action="Details" asp-route-id="@pa.PharmacyId" class="text-decoration-none">
                                        @pa.PharmacyName
                                    </a>
                                </td>
                                <td>@pa.PharmacyCity</td>
                                <td>
                                    @if (pa.PharmacyIsOpen)
                                    {
                                        <span class="badge bg-success">Open Now</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Closed</span>
                                    }
                                </td>
                                <td class="fw-bold">@pa.Price.ToString("F2") SAR</td>
                                <td>
                                    @switch (pa.AvailabilityStatus)
                                    {
                                        case AvailabilityStatus.Available:
                                            <span class="badge bg-success">Available</span>
                                            break;
                                        case AvailabilityStatus.LowStock:
                                            <span class="badge bg-warning text-dark">Low Stock</span>
                                            break;
                                        case AvailabilityStatus.OutOfStock:
                                            <span class="badge bg-danger">Out of Stock</span>
                                            break;
                                    }
                                </td>
                                <td>@pa.LastUpdated.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3">This medicine is not currently listed at any pharmacy.</div>
        }
    </div>

    <div class="alert alert-secondary mt-4">
        <i class="fas fa-info-circle me-2"></i><strong>Disclaimer:</strong> PharmaLink provides information about medicine availability and prices only. It does not provide medical diagnosis or treatment recommendations. Always consult a healthcare professional.
    </div>
</div>