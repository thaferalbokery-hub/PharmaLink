@model List<Prescription>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fas fa-prescription text-success me-2"></i>Prescriptions</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus me-1"></i>New Prescription</a>
</div>
<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-success"><tr><th>ID</th><th>Patient</th><th>Doctor</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>#@p.Id</td><td>@p.User.FullName</td><td>@(p.DoctorName ?? "-")</td>
                    <td>@p.PrescriptionDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        @switch(p.Status){
                            case PrescriptionStatus.Pending: <span class="badge bg-warning text-dark">Pending</span> break;
                            case PrescriptionStatus.Approved: <span class="badge bg-success">Approved</span> break;
                            case PrescriptionStatus.Dispensed: <span class="badge bg-info">Dispensed</span> break;
                            case PrescriptionStatus.Rejected: <span class="badge bg-danger">Rejected</span> break;
                            default: <span class="badge bg-secondary">Cancelled</span> break;
                        }
                    </td>
                    <td><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
</div>