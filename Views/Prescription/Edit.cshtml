@model Prescription
<h2 class="fw-bold mb-4"><i class="fas fa-edit text-success me-2"></i>Edit Prescription #@Model.Id</h2>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form asp-action="Edit" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                @foreach(var s in Enum.GetValues<PrescriptionStatus>())
                {
                    <option value="@((int)s)" selected="@(s == Model.Status)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Doctor Name</label>
            <input name="doctorName" value="@Model.DoctorName" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Date</label>
            <input value="@Model.PrescriptionDate.ToString("yyyy-MM-dd")" class="form-control" disabled />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Notes</label>
        <textarea name="notes" class="form-control" rows="3">@Model.Notes</textarea>
    </div>
    <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i>Update</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>
</div></div>

@if(Model.PrescriptionItems.Any())
{
    <h5 class="mt-4 fw-bold">Current Items</h5>
    <table class="table table-hover">
        <thead class="table-light"><tr><th>Medicine</th><th>Quantity</th><th>Dosage</th></tr></thead>
        <tbody>
            @foreach(var item in Model.PrescriptionItems)
            {
                <tr><td>@item.Medicine.Name</td><td>@item.Quantity</td><td>@(item.DosageInstructions ?? "-")</td></tr>
            }
        </tbody>
    </table>
}