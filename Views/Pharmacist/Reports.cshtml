@model PharmacistReportViewModel

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-chart-bar me-2 text-success"></i>Pharmacy Report - @Model.PharmacyName</h2>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="fw-bold text-primary">@Model.TotalInventory</h4><small>Total Items</small></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="fw-bold text-success">@Model.AvailableCount</h4><small>Available</small></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="fw-bold text-warning">@Model.LowStockCount</h4><small>Low Stock</small></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="fw-bold text-danger">@Model.OutOfStockCount</h4><small>Out of Stock</small></div></div></div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold">Summary</h6>
                    <table class="table table-sm">
                        <tr><td>Recent Updates (7 days)</td><td class="text-end fw-bold">@Model.RecentUpdatesCount</td></tr>
                        <tr><td>Average Price</td><td class="text-end fw-bold">@Model.AveragePrice.ToString("F2") SAR</td></tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold">Recent Price Updates</div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead><tr><th>Medicine</th><th>Price</th><th>Updated</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.RecentPriceUpdates.Take(5))
                            {
                                <tr><td>@item.MedicineName</td><td>@item.Price.ToString("F2")</td><td>@item.LastUpdated.ToString("MMM dd")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>