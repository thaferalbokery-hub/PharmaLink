@model List<PharmacyWorkingHour>

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-clock me-2 text-success"></i>Working Hours - @ViewBag.PharmacyName</h2>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table">
                    <thead class="table-success">
                        <tr><th>Day</th><th>Opening Time</th><th>Closing Time</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var wh in Model)
                        {
                            <tr>
                                <td class="fw-bold">@wh.DayOfWeek</td>
                                <td>@wh.OpeningTime.ToString(@"hh\:mm")</td>
                                <td>@wh.ClosingTime.ToString(@"hh\:mm")</td>
                                <td>
                                    @if (wh.IsClosed)
                                    {
                                        <span class="badge bg-danger">Closed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Open</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>