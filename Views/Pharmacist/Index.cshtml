<h2 class="fw-bold mb-4"><i class="fas fa-user-md text-success me-2"></i>Pharmacist Dashboard</h2>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4>@(ViewBag.PharmacyName ?? "No Pharmacy")</h4><small>My Pharmacy</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4>@(ViewBag.TotalInventory ?? 0)</h4><small>Inventory Items</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="text-danger">@(ViewBag.LowStock ?? 0)</h4><small>Low Stock</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="text-warning">@ViewBag.PendingPrescriptions</h4><small>Pending Rx</small></div></div></div>
</div>
<div class="row g-2">
    <div class="col-md-3"><a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-primary w-100"><i class="fas fa-boxes-stacked me-1"></i>Inventory</a></div>
    <div class="col-md-3"><a asp-controller="Sale" asp-action="Create" class="btn btn-outline-success w-100"><i class="fas fa-plus me-1"></i>New Sale</a></div>
    <div class="col-md-3"><a asp-controller="Prescription" asp-action="Index" class="btn btn-outline-warning w-100"><i class="fas fa-prescription me-1"></i>Prescriptions</a></div>
    <div class="col-md-3"><a asp-controller="Report" asp-action="Index" class="btn btn-outline-dark w-100"><i class="fas fa-chart-bar me-1"></i>Reports</a></div>
</div>