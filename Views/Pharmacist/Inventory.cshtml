@model List<InventoryItemViewModel>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-boxes me-2 text-success"></i>Inventory - @ViewBag.PharmacyName</h2>
        <a asp-action="AddInventory" class="btn btn-success"><i class="fas fa-plus me-2"></i>Add Medicine</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-success">
                        <tr>
                            <th>Medicine</th>
                            <th>Scientific Name</th>
                            <th>Category</th>
                            <th>Quantity</th>
                            <th>Price (SAR)</th>
                            <th>Status</th>
                            <th>Last Updated</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.MedicineName</td>
                                <td class="text-muted">@item.MedicineScientificName</td>
                                <td><span class="badge bg-info">@item.CategoryName</span></td>
                                <td>@item.Quantity</td>
                                <td>@item.Price.ToString("F2")</td>
                                <td>
                                    @switch (item.AvailabilityStatus)
                                    {
                                        case AvailabilityStatus.Available:
                                            <span class="badge bg-success">Available</span>
                                            break;
                                        case AvailabilityStatus.LowStock:
                                            <span class="badge bg-warning text-dark">Low Stock</span>
                                            break;
                                        case AvailabilityStatus.OutOfStock:
                                            <span class="badge bg-danger">Out of Stock</span>
                                            break;
                                    }
                                </td>
                                <td>@item.LastUpdated.ToString("MMM dd, HH:mm")</td>
                                <td>
                                    <a asp-action="UpdateInventory" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="RemoveInventory" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>