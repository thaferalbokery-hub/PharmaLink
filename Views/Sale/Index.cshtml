@model List<Sale>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fas fa-cash-register text-success me-2"></i>Sales</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus me-1"></i>New Sale</a>
</div>
<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-success"><tr><th>ID</th><th>Customer</th><th>Pharmacy</th><th>Date</th><th>Total</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>#@s.Id</td><td>@s.User.FullName</td><td>@s.Pharmacy.Name</td>
                    <td>@s.SaleDate.ToString("MMM dd, yyyy")</td>
                    <td class="fw-bold">@s.TotalAmount.ToString("C")</td>
                    <td>
                        @switch(s.Status){
                            case SaleStatus.Completed: <span class="badge bg-success">Completed</span> break;
                            case SaleStatus.Pending: <span class="badge bg-warning text-dark">Pending</span> break;
                            case SaleStatus.Cancelled: <span class="badge bg-danger">Cancelled</span> break;
                            default: <span class="badge bg-secondary">Refunded</span> break;
                        }
                    </td>
                    <td><a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
</div>