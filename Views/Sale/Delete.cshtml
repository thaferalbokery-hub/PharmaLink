@model Sale
<h2 class="fw-bold mb-4 text-danger"><i class="fas fa-trash me-2"></i>Delete Sale #@Model.Id</h2>
<div class="card border-0 shadow-sm"><div class="card-body">
    <p><strong>Customer:</strong> @Model.User.FullName</p>
    <p><strong>Pharmacy:</strong> @Model.Pharmacy.Name</p>
    <p><strong>Date:</strong> @Model.SaleDate.ToString("MMMM dd, yyyy")</p>
    <p><strong>Total:</strong> <span class="fw-bold text-success">@Model.TotalAmount.ToString("C")</span></p>
    <p><strong>Status:</strong> <span class="badge bg-info">@Model.Status</span></p>
    <p><strong>Items:</strong> @Model.SaleItems.Count item(s)</p>
    @if(Model.Status == SaleStatus.Completed)
    {
        <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>Inventory will be restored for completed sales.</div>
    }
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger"><i class="fas fa-trash me-1"></i>Confirm Delete</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
</div></div>