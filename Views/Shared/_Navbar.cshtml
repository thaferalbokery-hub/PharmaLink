@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            <i class="fas fa-pills me-2"></i>PharmaLink
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i>Home</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Medicine" asp-action="Index"><i class="fas fa-capsules me-1"></i>Medicines</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Pharmacy" asp-action="Index"><i class="fas fa-store me-1"></i>Pharmacies</a></li>
                @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.IsInRole("Pharmacist")))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Supplier" asp-action="Index"><i class="fas fa-truck me-1"></i>Suppliers</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Inventory" asp-action="Index"><i class="fas fa-boxes-stacked me-1"></i>Inventory</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Sale" asp-action="Index"><i class="fas fa-cash-register me-1"></i>Sales</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="SupplierMedicine" asp-action="Index"><i class="fas fa-link me-1"></i>Supply</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Report" asp-action="Index"><i class="fas fa-chart-bar me-1"></i>Reports</a></li>
                }
                @if (SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Prescription" asp-action="Index"><i class="fas fa-prescription me-1"></i>Prescriptions</a></li>
                }
            </ul>
            <ul class="navbar-nav">
                @if (SignInManager.IsSignedIn(User))
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="fas fa-tachometer-alt me-1"></i>Admin</a></li>
                    }
                    @if (User.IsInRole("Pharmacist"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Pharmacist" asp-action="Index"><i class="fas fa-user-md me-1"></i>Dashboard</a></li>
                    }
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="nav-link btn btn-link"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login"><i class="fas fa-sign-in-alt me-1"></i>Login</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </div>
    </div>
</nav>