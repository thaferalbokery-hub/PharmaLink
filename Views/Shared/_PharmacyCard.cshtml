@model PharmacyListViewModel

<div class="card h-100 shadow-sm border-0">
    @if (Model.ImageUrl != null)
    {
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="height: 160px; object-fit: cover;" />
    }
    else
    {
        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 160px;">
            <i class="fas fa-clinic-medical fa-3x text-success"></i>
        </div>
    }
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="card-title fw-bold mb-0">@Model.Name</h6>
            @if (Model.IsOpen)
            {
                <span class="badge bg-success">Open Now</span>
            }
            else
            {
                <span class="badge bg-danger">Closed</span>
            }
        </div>
        <p class="card-text small text-muted mb-1">
            <i class="fas fa-map-marker-alt me-1"></i>@Model.Address, @Model.City
        </p>
        @if (Model.Phone != null)
        {
            <p class="card-text small text-muted mb-1">
                <i class="fas fa-phone me-1"></i>@Model.Phone
            </p>
        }
        <div class="d-flex justify-content-between align-items-center mt-2">
            <small class="text-success">
                <i class="fas fa-pills me-1"></i>@Model.AvailableMedicineCount available
            </small>
            @if (Model.AverageRating > 0)
            {
                <small class="text-warning">
                    <i class="fas fa-star"></i> @Model.AverageRating.ToString("F1")
                </small>
            }
        </div>
    </div>
    <div class="card-footer bg-white border-0">
        <a asp-controller="Pharmacy" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-success btn-sm w-100">
            <i class="fas fa-eye me-1"></i>View Details
        </a>
    </div>
</div>