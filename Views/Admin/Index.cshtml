@model AdminDashboardViewModel

<div class="container-fluid py-4 px-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-tachometer-alt me-2 text-success"></i>Admin Dashboard</h2>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Total Users</h6>
                            <h2 class="fw-bold">@Model.TotalUsers</h2>
                        </div>
                        <i class="fas fa-users fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Pharmacies</h6>
                            <h2 class="fw-bold">@Model.TotalPharmacies</h2>
                        </div>
                        <i class="fas fa-store fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Medicines</h6>
                            <h2 class="fw-bold">@Model.TotalMedicines</h2>
                        </div>
                        <i class="fas fa-pills fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Categories</h6>
                            <h2 class="fw-bold">@Model.TotalCategories</h2>
                        </div>
                        <i class="fas fa-th-large fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Availability & Pharmacy Status -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold">
                    <i class="fas fa-chart-pie me-2 text-success"></i>Medicine Availability
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-around text-center">
                        <div>
                            <h3 class="text-success fw-bold">@Model.AvailableMedicines</h3>
                            <span class="badge bg-success">Available</span>
                        </div>
                        <div>
                            <h3 class="text-warning fw-bold">@Model.LowStockMedicines</h3>
                            <span class="badge bg-warning text-dark">Low Stock</span>
                        </div>
                        <div>
                            <h3 class="text-danger fw-bold">@Model.OutOfStockMedicines</h3>
                            <span class="badge bg-danger">Out of Stock</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold">
                    <i class="fas fa-store me-2 text-success"></i>Pharmacy Status
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-around text-center">
                        <div>
                            <h3 class="text-success fw-bold">@Model.OpenPharmacies</h3>
                            <span class="badge bg-success">Open</span>
                        </div>
                        <div>
                            <h3 class="text-danger fw-bold">@Model.ClosedPharmacies</h3>
                            <span class="badge bg-danger">Closed</span>
                        </div>
                        <div>
                            <h3 class="text-info fw-bold">@Model.TotalReviews</h3>
                            <span class="badge bg-info">Reviews</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold">
                    <i class="fas fa-bolt me-2 text-success"></i>Quick Actions
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-2">
                            <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-primary w-100">
                                <i class="fas fa-users d-block mb-1"></i>Users
                            </a>
                        </div>
                        <div class="col-md-2">
                            <a asp-controller="Pharmacy" asp-action="Create" class="btn btn-outline-success w-100">
                                <i class="fas fa-store d-block mb-1"></i>Add Pharmacy
                            </a>
                        </div>
                        <div class="col-md-2">
                            <a asp-controller="Medicine" asp-action="Create" class="btn btn-outline-info w-100">
                                <i class="fas fa-pills d-block mb-1"></i>Add Medicine
                            </a>
                        </div>
                        <div class="col-md-2">
                            <a asp-controller="Category" asp-action="Index" class="btn btn-outline-warning w-100">
                                <i class="fas fa-th-large d-block mb-1"></i>Categories
                            </a>
                        </div>
                        <div class="col-md-2">
                            <a asp-controller="Brand" asp-action="Index" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-tag d-block mb-1"></i>Brands
                            </a>
                        </div>
                        <div class="col-md-2">
                            <a asp-controller="Admin" asp-action="Reports" class="btn btn-outline-dark w-100">
                                <i class="fas fa-chart-bar d-block mb-1"></i>Reports
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>