<h2 class="fw-bold mb-4"><i class="fas fa-tachometer-alt text-success me-2"></i>Admin Dashboard</h2>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="text-primary">@ViewBag.TotalUsers</h4><small>Users</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="text-success">@ViewBag.TotalPharmacies</h4><small>Pharmacies</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="text-info">@ViewBag.TotalMedicines</h4><small>Medicines</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="text-warning">@ViewBag.TotalSuppliers</h4><small>Suppliers</small></div></div></div>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4>@ViewBag.TotalSales</h4><small>Total Sales</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="text-success">@(((decimal)ViewBag.TotalRevenue).ToString("C"))</h4><small>Revenue</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="text-danger">@ViewBag.LowStockCount</h4><small>Low Stock</small></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body text-center"><h4 class="text-warning">@ViewBag.PendingPrescriptions</h4><small>Pending Rx</small></div></div></div>
</div>
<div class="row g-2">
    <div class="col-md-2"><a asp-controller="Admin" asp-action="Users" class="btn btn-outline-primary w-100"><i class="fas fa-users"></i> Users</a></div>
    <div class="col-md-2"><a asp-controller="Medicine" asp-action="Create" class="btn btn-outline-success w-100"><i class="fas fa-plus"></i> Medicine</a></div>
    <div class="col-md-2"><a asp-controller="Pharmacy" asp-action="Create" class="btn btn-outline-info w-100"><i class="fas fa-plus"></i> Pharmacy</a></div>
    <div class="col-md-2"><a asp-controller="Supplier" asp-action="Create" class="btn btn-outline-warning w-100"><i class="fas fa-plus"></i> Supplier</a></div>
    <div class="col-md-2"><a asp-controller="Report" asp-action="Index" class="btn btn-outline-dark w-100"><i class="fas fa-chart-bar"></i> Reports</a></div>
    <div class="col-md-2"><a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-secondary w-100"><i class="fas fa-boxes-stacked"></i> Inventory</a></div>
</div>