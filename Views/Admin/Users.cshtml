@model List<ApplicationUser>
<h2 class="fw-bold mb-4"><i class="fas fa-users text-success me-2"></i>User Management</h2>
<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-success"><tr><th>Name</th><th>Email</th><th>Status</th><th>Joined</th></tr></thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr><td>@user.FullName</td><td>@user.Email</td><td>@(user.IsActive ? "Active" : "Inactive")</td><td>@user.CreatedAt.ToString("MMM dd, yyyy")</td></tr>
            }
        </tbody>
    </table>
</div>