@model ReportViewModel

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-chart-bar me-2 text-success"></i>Admin Reports</h2>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h4 class="text-primary fw-bold">@Model.TotalPharmacies</h4>
                    <p class="text-muted">Total Pharmacies</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h4 class="text-success fw-bold">@Model.TotalMedicines</h4>
                    <p class="text-muted">Total Medicines</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h4 class="text-info fw-bold">@Model.TotalCustomers</h4>
                    <p class="text-muted">Total Users</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold">Availability Statistics</div>
                <div class="card-body">
                    <table class="table">
                        <tr><td>Available</td><td class="text-end"><span class="badge bg-success">@Model.AvailableCount</span></td></tr>
                        <tr><td>Low Stock</td><td class="text-end"><span class="badge bg-warning text-dark">@Model.LowStockCount</span></td></tr>
                        <tr><td>Out of Stock</td><td class="text-end"><span class="badge bg-danger">@Model.OutOfStockCount</span></td></tr>
                        <tr><td>Open Pharmacies</td><td class="text-end"><span class="badge bg-success">@Model.OpenPharmacies</span></td></tr>
                        <tr><td>Closed Pharmacies</td><td class="text-end"><span class="badge bg-secondary">@Model.ClosedPharmacies</span></td></tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold">Most Searched Medicines</div>
                <div class="card-body">
                    @if (Model.MostSearchedMedicines.Any())
                    {
                        <table class="table">
                            <thead><tr><th>Term</th><th class="text-end">Searches</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.MostSearchedMedicines)
                                {
                                    <tr><td>@item.SearchTerm</td><td class="text-end">@item.SearchCount</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No search data yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold">Most Favorited Pharmacies</div>
                <div class="card-body">
                    @if (Model.MostFavoritedPharmacies.Any())
                    {
                        <table class="table">
                            <thead><tr><th>Pharmacy</th><th class="text-end">Favorites</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.MostFavoritedPharmacies)
                                {
                                    <tr><td>@item.PharmacyName</td><td class="text-end">@item.FavoriteCount</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No favorite data yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>